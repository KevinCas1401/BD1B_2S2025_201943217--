          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/centros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "centros"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": {
              "content": "**Propósito:** insertar un nuevo **centro**.  \n**Body:**  \n```json\n{ \"nombre\": \"Centro Zona 5\" }\n```\n**Notas:** El **ID** se autogenera (secuencia + trigger).  \n**Respuestas:** `201/200` (creado), `400` si falta `nombre`.",
              "type": "text/markdown"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Centro Zona 5\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function(){",
                  "  pm.expect(pm.response.code).to.be.within(200,299);",
                  "});"
                ]
              }
            }
          ]
        },
        {
